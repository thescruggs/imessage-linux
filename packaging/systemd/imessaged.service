# systemd *user* unit for imessaged.
#
#   install -Dm644 packaging/systemd/imessaged.service ~/.config/systemd/user/imessaged.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now imessaged
#
# State lives in %S/imessaged (= $XDG_STATE_HOME/imessaged, normally
# ~/.local/state/imessaged), which is also the daemon's default --state-dir.

[Unit]
Description=iMessage daemon (imessaged)
After=dbus.socket
Requires=dbus.socket

[Service]
# Type=simple (the D-Bus activation file below still works: dbus-daemon
# waits for the name to appear). Type=dbus + BusName=org.imessage.Daemon1
# would also be correct.
Type=simple
# `cargo install --path crates/imessaged` puts the binary here. For a
# distribution package use /usr/bin/imessaged instead.
ExecStart=%h/.cargo/bin/imessaged --state-dir %S/imessaged
Restart=on-failure
RestartSec=5

StateDirectory=imessaged
StateDirectoryMode=0700
UMask=0077

# The iCloud contacts sync writes the KPeople vCard folder (the daemon's
# default `contacts_dir`). ReadWritePaths= needs it to exist when the
# sandbox is set up; `+` runs mkdir outside the sandbox. If you set
# `contacts_dir` elsewhere, change both lines.
ExecStartPre=+/usr/bin/mkdir -p -m 700 %h/.local/share/kpeoplevcard

# Hardening. No MemoryDenyWriteExecute: the NAC emulator (unicorn) JITs. The home directory is read-only (SendFile reads files from it);
# only the state directory and the vCard folder are writable.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%S/imessaged %h/.local/share/kpeoplevcard
PrivateTmp=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=default.target
