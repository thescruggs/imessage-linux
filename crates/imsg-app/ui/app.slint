// imsg-app main window. All state lives in Rust (src/ui.rs); this file
// only lays it out, in the kmessages look (kmessages/src/qml). Colours
// and contrast ratios: theme.slint.

import { LineEdit, TextEdit, ScrollView, ListView, Switch, Palette } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";
import { Btn, IconBtn, LinkBtn, Avatar, Heading, Body, Overlay, TypingDots } from "widgets.slint";
import { ReactionItem, Tapbacks, ReactionChip, ChipTip, TapbackBar } from "tapbacks.slint";
// Embedded UI font: the software renderer has no font otherwise on a bare
// Windows / Wine (Phase-0 finding), and it frees us from the host's fonts.
import "../assets/fonts/NotoSans-Regular.ttf";
import "../assets/fonts/NotoSans-Bold.ttf";

export { Theme, ReactionItem, Tapbacks }

export struct ChatItem {
    id: string,
    title: string,
    initials: string,
    snippet: string,
    time: string,
    unread: int,
    pinned: bool,
    is-group: bool,
    sms: bool,
    typing: bool,
    selected: bool,
    avatar: image,
    has-avatar: bool,
    // "Pinned" / "Conversations" header above this row ("" = none)
    section: string,
    tint: int,
}

// kind: 0 = picture, 1 = file, 2 = link card (image = its preview
// picture when has-image)
export struct PartItem {
    kind: int,
    att-id: string,
    name: string,
    detail: string,
    image: image,
    img-w: int,
    img-h: int,
    loaded: bool,
    failed: bool,
    has-image: bool,
    url: string,
    title: string,
    site: string,
}

export struct MsgItem {
    id: string,
    header: string,
    sender: string,
    // the sender's name on every message ("You" for ours)
    who: string,
    from-me: bool,
    sms: bool,
    text: string,
    subject: string,
    // pictures and files (above the text bubble) and link cards (below)
    parts: [PartItem],
    links: [PartItem],
    has-link: bool,
    unsent: bool,
    edited: bool,
    unverified: bool,
    effect: string,
    reply-quote: string,
    reactions: [ReactionItem],
    // tapbacks allowed (not SMS / unsent); our current one ("" = none)
    can-react: bool,
    my-reaction: string,
    delivery: string,
    failed: bool,
    time: string,
    first-in-run: bool,
    last-in-run: bool,
    // groups: the incoming side keeps room for the sender's 24 px avatar,
    // drawn by the last bubble of a run
    in-group: bool,
    show-avatar: bool,
    sender-initials: string,
    sender-tint: int,
    sender-photo: image,
    has-sender-photo: bool,
}

export struct Suggestion {
    name: string,
    address: string,
}

// One chat list row (kmessages ChatListDelegate.qml), with the section
// header above it when it starts one.
component ChatRow inherits Rectangle {
    in property <ChatItem> item;
    callback clicked;
    property <length> section-h: root.item.section != "" ? max(30px, Theme.small * 2.2) : 0px;
    property <length> row-h: Theme.base * 1.45 + Theme.small * 2.9 + 16px;
    property <color> fg: root.item.selected ? Theme.on-selection : Theme.text-strong;
    property <color> fg-dim: root.item.selected ? Theme.on-selection : Theme.text-dim;
    height: root.section-h + root.row-h;

    if root.item.section != "": HorizontalLayout {
        y: 0;
        height: root.section-h;
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 6px;
        spacing: 8px;
        Text {
            text: root.item.section;
            color: Theme.text-dim;
            font-size: Theme.small;
            font-weight: 700;
            vertical-alignment: center;
            accessible-role: AccessibleRole.text;
        }
        VerticalLayout {
            alignment: center;
            padding-top: 2px;
            Rectangle { height: 1px; background: Theme.border; }
        }
    }

    Rectangle {
        y: root.section-h;
        height: root.row-h;
        background: root.item.selected ? Theme.selection : ta.has-hover ? Theme.hover : transparent;
        accessible-role: list-item;
        accessible-label: root.item.title + (root.item.unread > 0 ? ", " + root.item.unread + " unread" : "") + (root.item.pinned ? ", pinned" : "") + ". " + (root.item.typing ? "typing" : root.item.snippet);
        accessible-item-selected: root.item.selected;
        accessible-action-default => { root.clicked(); }

        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
        HorizontalLayout {
            padding-left: 6px;
            padding-right: 12px;
            spacing: 6px;
            // Unread: a blue dot at the far left (white on the selection).
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: root.item.unread <= 0 ? transparent : root.item.selected ? Theme.on-selection : Theme.unread;
                }
            }
            VerticalLayout {
                alignment: center;
                padding-right: 4px;
                Avatar {
                    initials: root.item.initials;
                    photo: root.item.avatar;
                    has-photo: root.item.has-avatar;
                    is-group: root.item.is-group;
                    tint: root.item.tint;
                    size: max(40px, Theme.base * 2.5);
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                horizontal-stretch: 1;
                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: root.item.title;
                        color: root.fg;
                        font-weight: root.item.unread > 0 ? 700 : 600;
                        overflow: elide;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    if root.item.pinned: VerticalLayout {
                        alignment: center;
                        Image {
                            source: Icons.pin;
                            colorize: root.fg-dim;
                            width: Theme.small;
                            height: self.width;
                            image-rendering: smooth;
                            accessible-role: none;
                        }
                    }
                    Text {
                        text: root.item.time;
                        color: root.fg-dim;
                        font-size: Theme.small;
                        horizontal-stretch: 0;
                        vertical-alignment: center;
                    }
                }
                if !root.item.typing: Text {
                    text: root.item.snippet;
                    color: root.fg-dim;
                    font-size: Theme.small;
                    wrap: word-wrap;
                    overflow: elide;
                    // Two lines at most.
                    height: min(self.preferred-height, Theme.small * 2.75);
                    vertical-alignment: top;
                }
                if root.item.typing: HorizontalLayout {
                    alignment: start;
                    padding-top: 2px;
                    TypingDots {
                        small: true;
                        fill: root.item.selected ? #ffffff40 : Theme.bubble-in;
                        dot-color: root.item.selected ? Theme.on-selection : Theme.text;
                    }
                }
            }
        }
    }
}

// One attachment / link card of a message, outside the text bubble
// (kmessages AttachmentView.qml / LinkPreview.qml). Every TouchArea here
// sits inside MessageView's hover area, so hovering one keeps the React
// button up.
component PartView inherits HorizontalLayout {
    in property <PartItem> p;
    in property <bool> from-me;
    in property <color> fill;
    in property <color> ink;
    in property <length> max-w;
    callback open-attachment(string, string);
    callback save-attachment(string, string);
    callback open-url(string);
    callback menu();
    alignment: root.from-me ? end : start;

    // A picture: corners baked into its pixels (images.rs); click opens
    // it, a hover button saves it.
    if root.p.kind == 0: Rectangle {
        width: root.p.loaded ? min(root.p.img-w * 1px, root.max-w) : min(240px, root.max-w);
        height: root.p.loaded ? self.width * root.p.img-h / max(1, root.p.img-w) : 150px;
        border-radius: 16px;
        background: root.p.loaded ? transparent : Theme.bubble-in;
        accessible-role: image;
        accessible-label: "Picture " + root.p.name;
        accessible-action-default => { root.open-attachment(root.p.att-id, root.p.name); }
        if root.p.loaded: Image {
            source: root.p.image;
            width: 100%;
            height: 100%;
            image-fit: ImageFit.fill;
            image-rendering: smooth;
        }
        if !root.p.loaded: Text {
            text: root.p.failed ? "Picture could not be shown" : "Loading picture…";
            color: Theme.text;
            font-size: Theme.small;
        }
        pic-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.open-attachment(root.p.att-id, root.p.name); }
            pointer-event(e) => {
                if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                    root.menu();
                }
            }
        }
        save := IconBtn {
            visible: pic-ta.has-hover || self.hovered;
            x: parent.width - self.width - 8px;
            y: parent.height - self.height - 8px;
            icon: Icons.download;
            label: "Save " + root.p.name + "…";
            fg: #FFFFFF;
            hover-bg: #000000c0;
            background: self.hovered ? #000000c0 : #00000090;
            clicked => { root.save-attachment(root.p.att-id, root.p.name); }
        }
    }

    // Any other file: a bubble-coloured pill; click opens, the download
    // button saves.
    if root.p.kind == 1: Rectangle {
        max-width: root.max-w;
        border-radius: min(18px, self.height / 2);
        background: root.fill;
        accessible-role: button;
        accessible-label: "File " + root.p.name + ", " + root.p.detail + ". Open";
        accessible-action-default => { root.open-attachment(root.p.att-id, root.p.name); }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.open-attachment(root.p.att-id, root.p.name); }
            pointer-event(e) => {
                if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                    root.menu();
                }
            }
        }
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 6px;
            padding-top: 7px;
            padding-bottom: 7px;
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                Image {
                    source: Icons.file;
                    colorize: root.ink;
                    width: Theme.base * 1.6;
                    height: self.width;
                    image-rendering: smooth;
                    accessible-role: none;
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text { text: root.p.name; color: root.ink; overflow: elide; accessible-role: none; }
                Text { text: root.p.detail; color: root.ink; font-size: Theme.small; overflow: elide; accessible-role: none; }
            }
            VerticalLayout {
                alignment: center;
                IconBtn {
                    icon: Icons.download;
                    label: "Save " + root.p.name + "…";
                    fg: root.ink;
                    hover-bg: Theme.dark || root.from-me ? #ffffff30 : #00000018;
                    clicked => { root.save-attachment(root.p.att-id, root.p.name); }
                }
            }
        }
    }

    // A link card: preview picture on top, bold title, site below.
    if root.p.kind == 2: Rectangle {
        property <length> card-w: min(root.max-w, 300px);
        width: self.card-w;
        border-radius: 16px;
        background: root.fill;
        accessible-role: button;
        accessible-label: "Link: " + (root.p.title != "" ? root.p.title : root.p.url) + (root.p.site != "" ? ", " + root.p.site : "");
        accessible-action-default => { root.open-url(root.p.url); }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.open-url(root.p.url); }
            pointer-event(e) => {
                if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                    root.menu();
                }
            }
        }
        VerticalLayout {
            if root.p.has-image && root.p.loaded: Image {
                source: root.p.image;
                width: parent.width;
                height: min(parent.width, parent.width * root.p.img-h / max(1, root.p.img-w));
                image-fit: cover;
                image-rendering: smooth;
                accessible-role: none;
            }
            if root.p.has-image && !root.p.loaded: Rectangle {
                height: parent.width * 0.52;
                border-top-left-radius: 16px;
                border-top-right-radius: 16px;
                background: root.ink.with-alpha(0.08);
            }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 7px;
                padding-bottom: 8px;
                spacing: 10px;
                if !root.p.has-image: VerticalLayout {
                    alignment: center;
                    Image {
                        source: Icons.globe;
                        colorize: root.ink;
                        width: Theme.base * 1.6;
                        height: self.width;
                        image-rendering: smooth;
                        accessible-role: none;
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    if root.p.title != "": Text {
                        text: root.p.title;
                        color: root.ink;
                        font-weight: 700;
                        wrap: word-wrap;
                        overflow: elide;
                        height: min(self.preferred-height, Theme.base * 2.8);
                        accessible-role: none;
                    }
                    Text {
                        text: root.p.site != "" ? root.p.site : root.p.url;
                        color: root.ink;
                        font-size: Theme.small;
                        overflow: elide;
                        accessible-role: none;
                    }
                }
            }
        }
    }
}

// One message (kmessages MessageDelegate.qml): time separator, sender
// name (groups), reply quote, attachments + text bubble (tail on the
// last of a run), tapback chips on the top outer corner (kept inside
// this item's rect: partial rendering), "Edited", the delivery label,
// the hover React button + time, and the tapback picker (right-click,
// double-click).
component MessageView inherits Rectangle {
    in property <MsgItem> m;
    in property <length> bubble-max;
    // Development only: open the picker (IMSG_APP_DEV_PICKER screenshots).
    in property <bool> dev-picker;
    callback open-attachment(string, string);
    callback save-attachment(string, string);
    callback open-url(string);
    callback react(string, string);

    property <length> side: 16px;
    property <length> av: max(24px, Theme.base * 1.5);
    property <length> gutter: root.m.in-group ? root.av + 6px : 0px;
    property <color> fill: root.m.from-me ? (root.m.sms ? Theme.bubble-sms : Theme.bubble-imessage) : Theme.bubble-in;
    property <color> ink: root.m.from-me ? Theme.on-bubble-out : Theme.text;
    property <bool> has-bubble: !root.m.unsent && (root.m.text != "" || root.m.subject != "" || root.m.effect != "");
    property <bool> tail: root.m.last-in-run && !root.m.has-link;
    property <length> chip-h: Theme.base * 1.45;
    property <length> chip-overlap: 6px;
    // Hover anywhere on the row (hover-ta is an ancestor of every link
    // and button in it, so it keeps has-hover over them).
    property <bool> hovered: hover-ta.has-hover || react-ta.has-hover;
    property <int> tip-index: -1;
    // The attachments + bubble stack, in this item's coordinates.
    property <length> stack-x: col.x + main-row.x + stack.x;
    property <length> stack-y: col.y + main-row.y + stack.y;

    preferred-height: col.preferred-height;
    min-height: col.min-height;

    function open-picker() {
        if (root.m.can-react) {
            picker.show();
        }
    }

    // (A Timer, not `changed`: a change handler on this repeated item's
    // property never ran in testing.)
    Timer {
        interval: 200ms;
        running: root.dev-picker;
        triggered => {
            self.running = false;
            root.open-picker();
        }
    }

    hover-ta := TouchArea {
        col := VerticalLayout {
            width: parent.width;
            height: parent.height;
            padding-left: root.side;
            padding-right: root.side;
            padding-top: root.m.first-in-run ? 10px : 0px;
            spacing: 2px;

            if root.m.header != "": Text {
                text: root.m.header;
                color: Theme.text-dim;
                font-size: Theme.small;
                horizontal-alignment: center;
                height: self.preferred-height + 10px;
                vertical-alignment: center;
                accessible-role: AccessibleRole.text;
            }
            // Sender name (groups) and the unverified-sender warning.
            if !root.m.unsent && !root.m.from-me && (root.m.sender != "" || (root.m.unverified && root.m.first-in-run)): HorizontalLayout {
                padding-left: root.gutter + 12px;
                spacing: 6px;
                alignment: start;
                if root.m.sender != "": Text {
                    text: root.m.sender;
                    color: Theme.text-dim;
                    font-size: Theme.small;
                }
                if root.m.unverified: HorizontalLayout {
                    spacing: 3px;
                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: Icons.warning;
                            colorize: Theme.negative;
                            width: Theme.small;
                            height: self.width;
                            image-rendering: smooth;
                        }
                    }
                    Text {
                        text: "Unverified sender";
                        color: Theme.negative;
                        font-size: Theme.small;
                        font-weight: 700;
                    }
                }
            }
            if root.m.unsent: Text {
                text: root.m.who + (root.m.from-me ? " unsent a message" : " unsent a message");
                color: Theme.text-dim;
                font-size: Theme.small;
                font-italic: true;
                horizontal-alignment: center;
                height: self.preferred-height + 6px;
                vertical-alignment: center;
            }
            // Reply quote: an outlined pill above the bubble.
            if !root.m.unsent && root.m.reply-quote != "": HorizontalLayout {
                alignment: root.m.from-me ? end : start;
                padding-left: root.gutter;
                Rectangle {
                    max-width: root.bubble-max;
                    border-radius: self.height / 2;
                    border-width: 2px;
                    border-color: Theme.bubble-in;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 3px;
                        padding-bottom: 3px;
                        Text {
                            text: root.m.reply-quote;
                            color: Theme.text-dim;
                            font-size: Theme.small;
                            overflow: elide;
                        }
                    }
                }
            }
            // Room for the tapback chips above the stack.
            if root.m.reactions.length > 0: Rectangle { height: root.chip-h - root.chip-overlap + 2px; }

            main-row := HorizontalLayout {
                alignment: root.m.from-me ? end : start;
                spacing: 6px;
                // Group: room for the sender's avatar (drawn below, on top
                // of the bubble tail's carving block).
                if root.m.in-group: Rectangle { width: root.av; }
                stack := VerticalLayout {
                    spacing: 2px;
                    max-width: root.bubble-max;
                    for p in root.m.parts: PartView {
                        p: p;
                        from-me: root.m.from-me;
                        fill: root.fill;
                        ink: root.ink;
                        max-w: root.bubble-max;
                        open-attachment(id, name) => { root.open-attachment(id, name); }
                        save-attachment(id, name) => { root.save-attachment(id, name); }
                        open-url(u) => { root.open-url(u); }
                        menu => { root.open-picker(); }
                    }
                    if root.has-bubble: HorizontalLayout {
                        alignment: root.m.from-me ? end : start;
                        bubble := Rectangle {
                            max-width: root.bubble-max;
                            accessible-role: AccessibleRole.text;
                            accessible-label: root.m.who + ": " + root.m.text + (root.m.time != "" ? ", " + root.m.time : "");
                            // Tail (kmessages): a bubble-coloured block whose outer
                            // edge is carved by a background-coloured rounded block.
                            if root.tail: Rectangle {
                                width: 20px;
                                height: min(25px, parent.height);
                                y: parent.height - self.height;
                                x: root.m.from-me ? parent.width - 13px : -7px;
                                background: root.fill;
                                border-bottom-left-radius: root.m.from-me ? 16px : 0px;
                                border-bottom-right-radius: root.m.from-me ? 0px : 16px;
                            }
                            if root.tail: Rectangle {
                                width: 26px;
                                height: min(25px, parent.height);
                                y: parent.height - self.height;
                                x: root.m.from-me ? parent.width : -26px;
                                background: Theme.bg;
                                border-bottom-left-radius: root.m.from-me ? 10px : 0px;
                                border-bottom-right-radius: root.m.from-me ? 0px : 10px;
                            }
                            Rectangle {
                                width: 100%;
                                height: 100%;
                                border-radius: min(18px, self.height / 2);
                                background: root.fill;
                            }
                            TouchArea {
                                pointer-event(e) => {
                                    if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                                        root.open-picker();
                                    }
                                }
                                double-clicked => { root.open-picker(); }
                            }
                            VerticalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                padding-top: 6px;
                                padding-bottom: 7px;
                                spacing: 4px;
                                if root.m.subject != "": Text {
                                    text: root.m.subject;
                                    color: root.ink;
                                    font-weight: 700;
                                    wrap: word-wrap;
                                    accessible-role: none;
                                }
                                if root.m.text != "": Text {
                                    text: root.m.text;
                                    color: root.ink;
                                    wrap: word-wrap;
                                    accessible-role: none;
                                }
                                if root.m.effect != "": Text {
                                    text: "Sent with " + root.m.effect;
                                    color: root.ink;
                                    font-size: Theme.small;
                                    font-italic: true;
                                    accessible-role: none;
                                }
                            }
                        }
                    }
                    for p in root.m.links: PartView {
                        p: p;
                        from-me: root.m.from-me;
                        fill: root.fill;
                        ink: root.ink;
                        max-w: root.bubble-max;
                        open-url(u) => { root.open-url(u); }
                        menu => { root.open-picker(); }
                    }
                }
            }
            if root.m.edited: Text {
                text: "Edited";
                color: Theme.accent;
                font-size: Theme.small;
                horizontal-alignment: root.m.from-me ? right : left;
            }
            if root.m.delivery != "": Text {
                text: root.m.delivery;
                color: root.m.failed ? Theme.negative : Theme.text-dim;
                font-size: Theme.small;
                font-weight: root.m.failed ? 700 : 400;
                horizontal-alignment: root.m.from-me ? right : left;
            }
        }
    }

    // Group: the sender's avatar by the run's last bubble.
    if root.m.show-avatar: Avatar {
        x: root.side;
        y: root.stack-y + stack.height - self.height;
        size: root.av;
        initials: root.m.sender-initials;
        photo: root.m.sender-photo;
        has-photo: root.m.has-sender-photo;
        tint: root.m.sender-tint;
    }

    // Hover: the React button beside the stack (outer side), then the time.
    react-btn := Rectangle {
        visible: root.m.can-react && root.hovered && !root.m.unsent;
        width: Theme.base * 1.75;
        height: self.width;
        x: root.m.from-me ? root.stack-x - self.width - 8px : root.stack-x + stack.width + 8px;
        y: root.stack-y + (stack.height - self.height) / 2;
        border-radius: self.width / 2;
        background: react-ta.pressed ? Theme.panel : react-ta.has-hover ? Theme.raised-hover : Theme.raised;
        border-width: 1px;
        border-color: Theme.border;
        accessible-role: button;
        accessible-label: "React";
        accessible-action-default => { root.open-picker(); }
        Image {
            source: Tapbacks.react-icon;
            colorize: Theme.text;
            width: parent.width * 0.6;
            height: self.width;
            image-rendering: smooth;
            accessible-role: none;
        }
        react-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.open-picker(); }
        }
    }
    if root.hovered && !root.m.unsent && root.m.time != "": Text {
        property <length> gap: root.m.can-react ? react-btn.width + 16px : 8px;
        text: root.m.time;
        color: Theme.text-dim;
        font-size: Theme.small;
        x: root.m.from-me ? max(0px, root.stack-x - self.gap - self.width) : min(root.width - self.width, root.stack-x + stack.width + self.gap);
        y: root.stack-y + (stack.height - self.height) / 2;
        accessible-role: none;
    }

    // Tapback chips centred on the stack's top outer corner (top-left of
    // ours, top-right of theirs), clamped to this item.
    chips := HorizontalLayout {
        visible: root.m.reactions.length > 0;
        spacing: -4px;
        width: self.preferred-width;
        height: root.chip-h;
        x: max(0px, min(root.width - self.width, (root.m.from-me ? root.stack-x : root.stack-x + stack.width) - self.width / 2));
        y: root.stack-y - root.chip-h + root.chip-overlap;
        for r[i] in root.m.reactions: ReactionChip {
            r: r;
            can-remove: root.m.can-react;
            remove => { root.react(root.m.id, r.kind); }
            changed hovered => {
                if (self.hovered) {
                    root.tip-index = i;
                } else if (root.tip-index == i) {
                    root.tip-index = -1;
                }
            }
        }
    }

    // Who reacted (hovered chip): beside the chips, on their line, so it
    // stays inside this item (a popup would take the click on the chip).
    if root.tip-index >= 0 && root.tip-index < root.m.reactions.length: ChipTip {
        text: root.m.reactions[root.tip-index].senders;
        x: root.m.from-me ? max(0px, chips.x - self.width - 4px) : min(root.width - self.width, chips.x + chips.width + 4px);
        y: chips.y + (root.chip-h - self.height) / 2;
    }

    picker := PopupWindow {
        close-policy: close-on-click-outside;
        x: root.m.from-me ? max(0px, root.stack-x + stack.width - bar.preferred-width) : root.stack-x;
        // Above the stack and its chips.
        y: root.stack-y - (root.m.reactions.length > 0 ? root.chip-h - root.chip-overlap : 0px) - bar.preferred-height - 4px;
        bar := TapbackBar {
            my-reaction: root.m.my-reaction;
            init => { self.focus-keys(); }
            picked(kind) => {
                picker.close();
                root.react(root.m.id, kind);
            }
            cancel => { picker.close(); }
        }
    }
}

// The composer's text field: a pill (kmessages Composer.qml) around a
// TextInput that scrolls once it is taller than six lines.
component ComposerField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    callback edited(string);
    callback send();
    out property <bool> has-focus: input.has-focus;
    property <length> line: Theme.base * 1.4;
    property <length> pad-v: 6px;

    public function focus-input() {
        input.focus();
    }

    height: clamp(input.preferred-height, root.line, root.line * 6) + 2 * root.pad-v;
    border-radius: min(18px, self.height / 2);
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    background: Theme.bg;
    accessible-role: none;

    ContextMenuArea {
        Menu {
            MenuItem { title: "Cut"; activated => { input.cut(); } }
            MenuItem { title: "Copy"; activated => { input.copy(); } }
            MenuItem { title: "Paste"; activated => { input.paste(); } }
            MenuItem { title: "Select All"; activated => { input.select-all(); } }
        }
        fl := Flickable {
            x: 14px;
            y: root.pad-v;
            width: parent.width - 28px;
            height: parent.height - 2 * root.pad-v;
            content-width: self.width;
            content-height: max(self.height, input.preferred-height);
            input := TextInput {
                width: fl.width;
                height: max(fl.height, self.preferred-height);
                text <=> root.text;
                single-line: false;
                wrap: word-wrap;
                color: Theme.text;
                font-size: Theme.base;
                selection-background-color: Theme.accent;
                selection-foreground-color: Theme.on-accent;
                accessible-role: text-input;
                accessible-label: "Message (Enter sends, Shift+Enter for a new line)";
                accessible-placeholder-text: root.placeholder;
                edited => { root.edited(self.text); }
                key-pressed(e) => {
                    if (e.text == Key.Return && !e.modifiers.shift && !e.modifiers.control && !e.modifiers.alt) {
                        root.send();
                        return accept;
                    }
                    reject
                }
                cursor-position-changed(cpos) => {
                    if (cpos.y + fl.content-y < 0px) {
                        fl.content-y = -cpos.y;
                    } else if (cpos.y + fl.content-y > fl.height - root.line) {
                        fl.content-y = min(0px, fl.height - cpos.y - root.line);
                    }
                }
            }
        }
    }
    if root.text == "": Text {
        // Just right of the cursor, which sits at the input's x.
        x: 16px;
        y: root.pad-v;
        text: root.placeholder;
        color: Theme.text-dim;
        font-size: Theme.base;
        accessible-role: none;
    }
}

export component AppWindow inherits Window {
    title: root.window-title;
    icon: @image-url("../assets/icon.png");
    default-font-family: "Noto Sans";
    default-font-size: Theme.base;
    background: Theme.bg;
    preferred-width: 1120px;
    preferred-height: 780px;
    min-width: 660px;
    min-height: 480px;

    in property <string> window-title: "imsg";
    // 0 = pairing, 1 = unlock, 2 = main
    in property <int> screen: 0;
    in property <string> busy;
    in property <string> error;
    in property <string> app-info;
    in property <bool> has-default-bridge;

    // ----- main -----
    in property <[ChatItem]> chats;
    in property <[MsgItem]> messages;
    in property <string> chat-title;
    in property <string> chat-subtitle;
    in property <bool> chat-open;
    in property <bool> can-load-older;
    in property <bool> loading-older;
    in property <bool> loading-chat;
    // "Bob is typing…" (the transcript shows a typing bubble)
    in property <string> typing;
    in property <string> service-label: "iMessage";
    // Status footer: text and dot (0 ok, 1 on the way, 2 problem).
    in property <string> status-text: "Connecting to the bridge…";
    in property <int> status-level: 1;
    in property <string> notice;
    in-out property <string> composer-text;
    in-out property <string> search-text;
    in-out property <bool> anchor-prepend;
    // Bumped by ui.rs after a restore from minimized and on focus: the
    // repaint rectangle at the end makes the whole window dirty, so the
    // software renderer draws a full frame (docs/PORTABLE-WINDOWS.md).
    in property <int> repaint-nonce;
    // Development only: the message whose tapback picker is open
    // (IMSG_APP_DEV_PICKER screenshots).
    in property <string> dev-picker;

    // ----- overlays -----
    in-out property <bool> settings-open;
    in-out property <bool> new-open;
    in-out property <bool> twofa-open;
    in property <string> dialog-error;
    in property <string> dialog-busy;
    in property <[Suggestion]> suggestions;
    in-out property <string> new-to;
    in-out property <string> new-text;
    // settings
    in-out property <string> set-bridge-url;
    in-out property <bool> set-notify;
    in-out property <bool> set-notify-text;
    in-out property <bool> set-log;
    in-out property <int> set-font: 1;
    // 0 = follow the system, 1 = light, 2 = dark
    in-out property <int> set-theme: 0;
    in property <string> settings-message;

    callback pair(string, string, string);
    callback unlock(string);
    callback forget-pairing();
    callback select-chat(string);
    callback load-older();
    callback send(string);
    callback composer-edited(string);
    callback attach();
    callback open-attachment(string, string);
    callback save-attachment(string, string);
    callback open-url(string);
    // message id, tapback kind ("love" … "question") or emoji
    callback react(string, string);
    callback search-edited(string);
    callback new-to-edited(string);
    callback send-new(string, string);
    callback submit-two-factor(string);
    callback save-bridge-url(string);
    callback repair(string);
    callback change-passphrase(string, string, string);
    callback settings-changed();
    callback clear-cache();
    callback sign-out();
    callback overlays-closed();

    property <bool> at-bottom: true;
    property <length> last-th;
    property <bool> confirm-forget;
    property <bool> confirm-signout;
    property <length> bar-h: max(52px, Theme.base * 1.4 + Theme.small * 1.4 + 14px);
    property <bool> sms-chat: root.service-label == "Text Message";

    public function scroll-to-bottom() {
        root.at-bottom = true;
        transcript.content-y = min(0px, transcript.visible-height - tcol.preferred-height);
    }

    public function focus-composer() {
        composer.focus-input();
    }

    // On entering the main screen: something must hold the focus for the
    // shortcuts (capture-key-pressed runs along the focus chain only).
    public function focus-search() {
        search.focus();
    }

    public function focus-passphrase() {
        if (root.screen == 1) {
            unlock-pass.focus();
        } else if (root.screen == 0) {
            pair-string.focus();
        }
    }

    // Light or dark colours for everything (our Theme and the std
    // widgets): ui.rs, from the setting. 0 = follow the system (the
    // palette is left `unknown`, so Fluent reads Slint's system colour
    // scheme, which the winit backend keeps up to date), 1 = light,
    // 2 = dark.
    public function set-theme-mode(mode: int) {
        Palette.color-scheme = mode == 1 ? ColorScheme.light : mode == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }

    property <length> th: tcol.preferred-height;
    changed th => {
        if (root.anchor-prepend) {
            transcript.content-y = min(0px, max(transcript.visible-height - root.th, transcript.content-y - (root.th - root.last-th)));
            root.anchor-prepend = false;
        } else if (root.at-bottom) {
            transcript.content-y = min(0px, transcript.visible-height - root.th);
        }
        root.last-th = root.th;
    }

    function close-overlays() {
        root.settings-open = false;
        root.new-open = false;
        root.twofa-open = false;
        root.confirm-signout = false;
        root.overlays-closed();
    }

    keys := FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        capture-key-pressed(e) => {
            if (e.text == Key.Escape && (root.settings-open || root.new-open || root.twofa-open)) {
                root.close-overlays();
                return accept;
            }
            if (root.screen == 2 && e.modifiers.control && !e.modifiers.alt) {
                if (e.text == "n" || e.text == "N") {
                    root.new-open = true;
                    return accept;
                }
                if (e.text == "f" || e.text == "F") {
                    search.focus();
                    return accept;
                }
                if (e.text == ",") {
                    root.settings-open = true;
                    return accept;
                }
            }
            reject
        }

        // ================= pairing =================
        Rectangle {
            visible: root.screen == 0;
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    padding-left: 24px;
                    padding-right: 24px;
                    VerticalLayout {
                        max-width: 620px;
                        horizontal-stretch: 1;
                        spacing: 12px;
                        Heading { text: "Pair with your bridge"; font-size: Theme.base * 1.6; }
                        Body {
                            text: "On the Linux host, run  imsg-bridge token new <name>  and paste the pairing string it prints (imsg+bridge://…#…)" + (root.has-default-bridge ? ", or just the token." : ".");
                        }
                        pair-string := LineEdit {
                            placeholder-text: "imsg+bridge://100.64.0.10:7227#…";
                            accessible-label: "Pairing string";
                        }
                        Body {
                            text: "Choose a passphrase (at least 8 characters). It encrypts the token on this computer or stick; you type it every time the app starts.";
                        }
                        pass1 := LineEdit {
                            input-type: password;
                            placeholder-text: "New passphrase";
                            accessible-label: "New passphrase";
                        }
                        pass2 := LineEdit {
                            input-type: password;
                            placeholder-text: "Repeat the passphrase";
                            accessible-label: "Repeat the passphrase";
                            accepted => { root.pair(pair-string.text, pass1.text, pass2.text); }
                        }
                        HorizontalLayout {
                            alignment: start;
                            spacing: 12px;
                            Btn {
                                text: "Pair";
                                primary: true;
                                enabled: root.busy == "";
                                clicked => { root.pair(pair-string.text, pass1.text, pass2.text); }
                            }
                            Text { text: root.busy; color: Theme.text; vertical-alignment: center; }
                        }
                        if root.error != "": Text { text: root.error; color: Theme.negative; wrap: word-wrap; font-weight: 700; }
                        Text { text: root.app-info; color: Theme.text-dim; font-size: Theme.small; wrap: word-wrap; }
                    }
                }
            }
        }

        // ================= unlock =================
        Rectangle {
            visible: root.screen == 1;
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    padding-left: 24px;
                    padding-right: 24px;
                    VerticalLayout {
                        max-width: 520px;
                        horizontal-stretch: 1;
                        spacing: 12px;
                        Heading { text: "Unlock"; font-size: Theme.base * 1.6; }
                        Body { text: "Enter your passphrase to connect to the bridge."; }
                        unlock-pass := LineEdit {
                            input-type: password;
                            placeholder-text: "Passphrase";
                            accessible-label: "Passphrase";
                            enabled: root.busy == "";
                            accepted => { root.unlock(self.text); }
                        }
                        HorizontalLayout {
                            alignment: start;
                            spacing: 12px;
                            Btn {
                                text: "Unlock";
                                primary: true;
                                enabled: root.busy == "";
                                clicked => { root.unlock(unlock-pass.text); }
                            }
                            Text { text: root.busy; color: Theme.text; vertical-alignment: center; }
                        }
                        if root.error != "": Text { text: root.error; color: Theme.negative; wrap: word-wrap; font-weight: 700; }
                        Rectangle { height: 24px; }
                        if !root.confirm-forget: HorizontalLayout {
                            alignment: start;
                            Btn {
                                text: "Forgot the passphrase? Pair again…";
                                small: true;
                                clicked => { root.confirm-forget = true; }
                            }
                        }
                        if root.confirm-forget: VerticalLayout {
                            spacing: 8px;
                            Body { text: "This deletes the saved pairing (secrets.bin). You will need a new pairing string from the host."; }
                            HorizontalLayout {
                                alignment: start;
                                spacing: 8px;
                                Btn {
                                    text: "Delete and pair again";
                                    primary: true;
                                    clicked => {
                                        root.confirm-forget = false;
                                        root.forget-pairing();
                                    }
                                }
                                Btn { text: "Cancel"; clicked => { root.confirm-forget = false; } }
                            }
                        }
                        Text { text: root.app-info; color: Theme.text-dim; font-size: Theme.small; wrap: word-wrap; }
                    }
                }
            }
        }

        // ================= main =================
        Rectangle {
          visible: root.screen == 2;
          VerticalLayout {
            HorizontalLayout {
                vertical-stretch: 1;
                // ----- chat list -----
                Rectangle {
                    min-width: 260px;
                    max-width: 380px;
                    preferred-width: 340px;
                    horizontal-stretch: 0;
                    background: Theme.bg;
                    VerticalLayout {
                        // Toolbar: "Messages", new message, settings.
                        Rectangle {
                            height: root.bar-h;
                            background: Theme.panel;
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 8px;
                                spacing: 2px;
                                Text {
                                    text: "Messages";
                                    color: Theme.text-strong;
                                    font-size: Theme.base * 1.15;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    accessible-role: AccessibleRole.text;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    IconBtn {
                                        icon: Icons.compose;
                                        label: "New message (Ctrl+N)";
                                        clicked => { root.new-open = true; }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    IconBtn {
                                        icon: Icons.settings;
                                        label: "Settings (Ctrl+,)";
                                        clicked => { root.settings-open = true; }
                                    }
                                }
                            }
                        }
                        Rectangle { height: 1px; background: Theme.border; }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 8px;
                            padding-bottom: 6px;
                            search := LineEdit {
                                placeholder-text: "Search (Ctrl+F)";
                                accessible-label: "Search chats";
                                text <=> root.search-text;
                                edited(t) => { root.search-edited(t); }
                                horizontal-stretch: 1;
                            }
                        }
                        ListView {
                            vertical-stretch: 1;
                            for c in root.chats: ChatRow {
                                item: c;
                                clicked => { root.select-chat(c.id); }
                            }
                        }
                        if root.chats.length == 0: Text {
                            text: root.search-text != "" ? "No chats match." : "No chats yet.";
                            color: Theme.text-dim;
                            horizontal-alignment: center;
                            vertical-stretch: 1;
                        }
                    }
                }
                Rectangle { width: 1px; background: Theme.border; }
                // ----- transcript -----
                Rectangle {
                  horizontal-stretch: 1;
                  background: Theme.bg;
                  VerticalLayout {
                    // Toolbar: chat title (bold) and its participants.
                    Rectangle {
                        height: root.bar-h;
                        background: Theme.panel;
                        if root.chat-open: HorizontalLayout {
                            padding-left: 18px;
                            padding-right: 16px;
                            VerticalLayout {
                                alignment: center;
                                Text { text: root.chat-title; color: Theme.text-strong; font-weight: 700; font-size: Theme.base * 1.1; overflow: elide; }
                                if root.chat-subtitle != "": Text { text: root.chat-subtitle; color: Theme.text-dim; font-size: Theme.small; overflow: elide; }
                            }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                    transcript := ScrollView {
                        vertical-stretch: 1;
                        content-width: self.visible-width;
                        content-height: tcol.preferred-height;
                        scrolled => {
                            root.at-bottom = self.content-y <= self.visible-height - root.th + 32px;
                            if (self.content-y >= -80px && root.can-load-older && !root.loading-older) {
                                root.load-older();
                            }
                        }
                        changed visible-height => {
                            if (root.at-bottom) {
                                self.content-y = min(0px, self.visible-height - root.th);
                            }
                        }
                        tcol := VerticalLayout {
                            width: transcript.visible-width;
                            padding-top: 8px;
                            padding-bottom: 12px;
                            if root.can-load-older || root.loading-older: HorizontalLayout {
                                alignment: center;
                                padding: 6px;
                                Btn {
                                    text: root.loading-older ? "Loading older messages…" : "Load older messages";
                                    small: true;
                                    enabled: !root.loading-older;
                                    clicked => { root.load-older(); }
                                }
                            }
                            if root.loading-chat && root.messages.length == 0: Text {
                                text: "Loading…";
                                color: Theme.text-dim;
                                horizontal-alignment: center;
                            }
                            for m in root.messages: MessageView {
                                m: m;
                                dev-picker: root.dev-picker != "" && root.dev-picker == m.id;
                                react(id, kind) => { root.react(id, kind); }
                                bubble-max: max(160px, min(540px, (transcript.visible-width - 32px - (m.in-group ? 30px : 0px)) * 0.75));
                                open-attachment(id, name) => { root.open-attachment(id, name); }
                                save-attachment(id, name) => { root.save-attachment(id, name); }
                                open-url(u) => { root.open-url(u); }
                            }
                            // Someone is typing: three dots in an incoming bubble.
                            if root.typing != "": HorizontalLayout {
                                alignment: start;
                                padding-left: 16px;
                                padding-top: 10px;
                                TypingDots {
                                    accessible-role: AccessibleRole.text;
                                    accessible-label: root.typing;
                                }
                            }
                        }
                    }
                    // Composer: attach, the pill, send.
                    Rectangle { height: 1px; background: Theme.border; }
                    Rectangle {
                        background: Theme.bg;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            spacing: 6px;
                            VerticalLayout {
                                alignment: end;
                                padding-bottom: 2px;
                                IconBtn {
                                    icon: Icons.paperclip;
                                    label: "Attach a file";
                                    clicked => { root.attach(); }
                                }
                            }
                            composer := ComposerField {
                                horizontal-stretch: 1;
                                text <=> root.composer-text;
                                placeholder: root.service-label;
                                edited(t) => { root.composer-edited(t); }
                                send => { root.send(root.composer-text); }
                            }
                            VerticalLayout {
                                alignment: end;
                                padding-bottom: 2px;
                                IconBtn {
                                    icon: Icons.send;
                                    label: "Send";
                                    enabled: root.composer-text != "";
                                    fg: root.sms-chat ? Theme.bubble-sms : Theme.bubble-imessage;
                                    clicked => { root.send(root.composer-text); }
                                }
                            }
                        }
                    }
                }
                  if !root.chat-open: Rectangle {
                    y: root.bar-h + 1px;
                    height: parent.height - root.bar-h - 1px;
                    background: Theme.bg;
                    TouchArea { }
                    Text {
                        text: "Pick a chat on the left, or start a new message (Ctrl+N).";
                        color: Theme.text-dim;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                        width: parent.width - 48px;
                    }
                  }
                }
            }
            // ----- status footer -----
            Rectangle { height: 1px; background: Theme.border; }
            Rectangle {
                background: Theme.panel;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 5px;
                    padding-bottom: 5px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 9px;
                            height: 9px;
                            border-radius: 4.5px;
                            background: root.status-level == 0 ? Theme.positive : root.status-level == 1 ? Theme.neutral : Theme.negative;
                        }
                    }
                    Text {
                        text: root.status-text;
                        color: root.status-level == 2 ? Theme.negative : Theme.text;
                        font-weight: root.status-level == 2 ? 700 : 400;
                        font-size: Theme.small;
                        overflow: elide;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        accessible-role: AccessibleRole.text;
                        accessible-label: "Status: " + root.status-text;
                    }
                    Text {
                        text: root.notice;
                        color: Theme.text;
                        font-size: Theme.small;
                        overflow: elide;
                        horizontal-alignment: right;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                }
            }
          }
        }
        // ================= new message =================
        if root.new-open && root.screen == 2: Overlay {
            panel-width: 620px;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Heading { text: "New message"; }
                Body { text: "To: phone numbers, email addresses or contact names, separated by commas."; }
                to := LineEdit {
                    text <=> root.new-to;
                    placeholder-text: "Bob Smith, +1 555 123 4567";
                    accessible-label: "Recipients";
                    edited(t) => { root.new-to-edited(t); }
                    init => { self.focus(); }
                }
                for s in root.suggestions: Rectangle {
                    height: sug.preferred-height + 10px;
                    background: sta.has-hover ? Theme.hover : Theme.bg;
                    border-radius: 4px;
                    accessible-role: button;
                    accessible-label: "Add " + s.name + ", " + s.address;
                    accessible-action-default => { sta.clicked(); }
                    sug := Text {
                        x: 10px;
                        text: s.name + "  —  " + s.address;
                        color: Theme.text-strong;
                    }
                    sta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.new-to-edited("\u{0}" + s.address); }
                    }
                }
                TextEdit {
                    text <=> root.new-text;
                    height: Theme.base * 6;
                    wrap: word-wrap;
                    placeholder-text: "Message";
                    accessible-label: "Message";
                }
                if root.dialog-error != "": Text { text: root.dialog-error; color: Theme.negative; font-weight: 700; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Text { text: root.dialog-busy; color: Theme.text; vertical-alignment: center; }
                    Btn { text: "Cancel"; clicked => { root.close-overlays(); } }
                    Btn {
                        text: "Send";
                        primary: true;
                        enabled: root.dialog-busy == "" && root.new-to != "" && root.new-text != "";
                        clicked => { root.send-new(root.new-to, root.new-text); }
                    }
                }
            }
        }

        // ================= two-factor =================
        if root.twofa-open && root.screen == 2: Overlay {
            panel-width: 480px;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Heading { text: "Apple wants a verification code"; }
                Body { text: "imessaged on the host is signing in again. Enter the 6-digit code shown on your Apple device."; }
                code := LineEdit {
                    placeholder-text: "123456";
                    input-type: number;
                    accessible-label: "Verification code";
                    init => { self.focus(); }
                    accepted => { root.submit-two-factor(self.text); }
                }
                if root.dialog-error != "": Text { text: root.dialog-error; color: Theme.negative; font-weight: 700; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Text { text: root.dialog-busy; color: Theme.text; vertical-alignment: center; }
                    Btn { text: "Later"; clicked => { root.close-overlays(); } }
                    Btn {
                        text: "Submit";
                        primary: true;
                        enabled: root.dialog-busy == "";
                        clicked => { root.submit-two-factor(code.text); }
                    }
                }
            }
        }

        // ================= settings =================
        if root.settings-open && root.screen == 2: Overlay {
            panel-width: 680px;
            ScrollView {
                height: min(root.height - 48px, sv.preferred-height);
                sv := VerticalLayout {
                    padding: 20px;
                    spacing: 10px;
                    HorizontalLayout {
                        Heading { text: "Settings"; horizontal-stretch: 1; }
                        Btn { text: "Close"; clicked => { root.close-overlays(); } }
                    }
                    if root.settings-message != "": Text { text: root.settings-message; color: Theme.accent; font-weight: 700; wrap: word-wrap; }

                    Text { text: "Colours"; color: Theme.text-strong; font-weight: 700; }
                    HorizontalLayout {
                        alignment: start;
                        spacing: 8px;
                        Btn { text: "Like Windows"; primary: root.set-theme == 0; clicked => { root.set-theme = 0; root.settings-changed(); } }
                        Btn { text: "Light"; primary: root.set-theme == 1; clicked => { root.set-theme = 1; root.settings-changed(); } }
                        Btn { text: "Dark"; primary: root.set-theme == 2; clicked => { root.set-theme = 2; root.settings-changed(); } }
                    }

                    Text { text: "Text size"; color: Theme.text-strong; font-weight: 700; }
                    HorizontalLayout {
                        alignment: start;
                        spacing: 8px;
                        Btn { text: "Small"; primary: root.set-font == 0; clicked => { root.set-font = 0; root.settings-changed(); } }
                        Btn { text: "Medium"; primary: root.set-font == 1; clicked => { root.set-font = 1; root.settings-changed(); } }
                        Btn { text: "Large"; primary: root.set-font == 2; clicked => { root.set-font = 2; root.settings-changed(); } }
                    }

                    Text { text: "Notifications"; color: Theme.text-strong; font-weight: 700; }
                    Switch {
                        text: "Notify about new messages";
                        checked <=> root.set-notify;
                        toggled => { root.settings-changed(); }
                    }
                    Switch {
                        text: "Show the message text (off: sender only)";
                        checked <=> root.set-notify-text;
                        toggled => { root.settings-changed(); }
                    }
                    Switch {
                        text: "Write a log file (logs/imsg-app.log, no message text)";
                        checked <=> root.set-log;
                        toggled => { root.settings-changed(); }
                    }

                    Text { text: "Bridge"; color: Theme.text-strong; font-weight: 700; }
                    HorizontalLayout {
                        spacing: 8px;
                        url := LineEdit {
                            text <=> root.set-bridge-url;
                            accessible-label: "Bridge URL";
                            horizontal-stretch: 1;
                        }
                        Btn { text: "Save URL"; clicked => { root.save-bridge-url(url.text); } }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        repair := LineEdit {
                            placeholder-text: "New pairing string (imsg+bridge://…#…)";
                            accessible-label: "New pairing string";
                            horizontal-stretch: 1;
                        }
                        Btn { text: "Re-pair"; clicked => { root.repair(repair.text); repair.text = ""; } }
                    }

                    Text { text: "Change passphrase"; color: Theme.text-strong; font-weight: 700; }
                    old-pass := LineEdit { input-type: password; placeholder-text: "Current passphrase"; accessible-label: "Current passphrase"; }
                    new-pass1 := LineEdit { input-type: password; placeholder-text: "New passphrase"; accessible-label: "New passphrase"; }
                    new-pass2 := LineEdit { input-type: password; placeholder-text: "Repeat the new passphrase"; accessible-label: "Repeat the new passphrase"; }
                    HorizontalLayout {
                        alignment: start;
                        Btn {
                            text: "Change passphrase";
                            clicked => {
                                root.change-passphrase(old-pass.text, new-pass1.text, new-pass2.text);
                                old-pass.text = "";
                                new-pass1.text = "";
                                new-pass2.text = "";
                            }
                        }
                    }

                    Text { text: "This computer"; color: Theme.text-strong; font-weight: 700; }
                    HorizontalLayout {
                        alignment: start;
                        spacing: 8px;
                        Btn { text: "Clear cache"; clicked => { root.clear-cache(); } }
                        if !root.confirm-signout: Btn { text: "Sign out (forget pairing)…"; clicked => { root.confirm-signout = true; } }
                        if root.confirm-signout: Btn {
                            text: "Really sign out";
                            primary: true;
                            clicked => {
                                root.confirm-signout = false;
                                root.sign-out();
                            }
                        }
                    }
                    Text { text: root.app-info; color: Theme.text; font-size: Theme.small; wrap: word-wrap; }
                }
            }
        }
    }

    // Full-window repaint (see repaint-nonce): top-most, invisible, takes
    // no input; a changed background dirties its whole rectangle.
    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: Math.mod(root.repaint-nonce, 2) == 0 ? #00000000 : #ffffff00;
    }
}
