diff --git a/src/auth.rs b/src/auth.rs
index e8e7f7b..4890843 100644
--- a/src/auth.rs
+++ b/src/auth.rs
@@ -404,6 +404,15 @@ pub async fn login_apple_delegates<T: AnisetteProvider>(account: &AppleAccount<T
     let base_headers = account.anisette.lock().await.get_headers().await?.clone();
     let mut anisette_headers: HeaderMap = base_headers.into_iter().map(|(a, b)| (HeaderName::from_str(&a).unwrap(), b.parse().unwrap())).collect();
 
+    // The anisette provider must not speak for the device here: its own client-info string
+    // disagrees with the OSConfig below (Apple answers that mismatch with an UNAUTHORIZED
+    // "add a trusted phone number"), and its device id is the ADI identifier, not ours.
+    anisette_headers.remove("X-Mme-Client-Info");
+    anisette_headers.insert(
+        "X-Mme-Device-Id",
+        HeaderValue::from_str(&os_config.get_device_uuid()).unwrap(),
+    );
+
     if let Some(cookie) = cookie {
         anisette_headers.insert("Cookie", HeaderValue::from_str(cookie).unwrap());
     }
