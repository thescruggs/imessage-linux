+#[cfg(all(not(target_os = "macos"), feature = "local-anisette"))]
+mod local_anisette {
+    use super::*;
+    use crate::adi_proxy::ADIProxyAnisetteProvider;
+    use crate::anisette_headers_provider::AnisetteHeadersProvider;
+    use crate::store_services_core::StoreServicesCoreADIProxy;
+
+    /// Anisette from Apple's own ADI library, loaded and run on this device — no anisette server
+    /// in the path. `lib_path` is the directory holding `lib/<abi>/libstoreservicescore.so`
+    /// (the caller extracts those from assets); provisioning state is kept alongside it.
+    ///
+    /// Construction is deferred to the first header request: loading the library and provisioning
+    /// are expensive and can fail, and an already-registered client never needs either.
+    pub struct SSCAnisetteProvider {
+        lib_path: PathBuf,
+        inner: Option<ADIProxyAnisetteProvider<StoreServicesCoreADIProxy<'static>>>,
+    }
+
+    // The loaded library is confined to this struct and only ever touched behind the
+    // AnisetteClient's Mutex, so moving it between threads is safe.
+    unsafe impl Send for SSCAnisetteProvider {}
+
+    impl SSCAnisetteProvider {
+        pub fn new(lib_path: PathBuf) -> Self {
+            SSCAnisetteProvider { lib_path, inner: None }
+        }
+
+        fn provider(
+            &mut self,
+        ) -> Result<&mut ADIProxyAnisetteProvider<StoreServicesCoreADIProxy<'static>>, AnisetteError>
+        {
+            if self.inner.is_none() {
+                let proxy = StoreServicesCoreADIProxy::new(&self.lib_path)?;
+                self.inner = Some(ADIProxyAnisetteProvider::new(proxy, self.lib_path.clone())?);
+            }
+            Ok(self.inner.as_mut().expect("just built"))
+        }
+    }
+
+    impl AnisetteProvider for SSCAnisetteProvider {
+        async fn get_anisette_headers(&mut self) -> Result<HashMap<String, String>, AnisetteError> {
+            self.provider()?.get_authentication_headers().await
+        }
+    }
+}
+
+#[cfg(all(not(target_os = "macos"), feature = "local-anisette"))]
+pub use local_anisette::SSCAnisetteProvider;
+
+#[cfg(all(not(target_os = "macos"), feature = "local-anisette"))]
+pub type DefaultAnisetteProvider = SSCAnisetteProvider;
+#[cfg(all(not(target_os = "macos"), feature = "local-anisette"))]
+pub fn default_provider(_info: LoginClientInfo, path: PathBuf) -> ArcAnisetteClient<DefaultAnisetteProvider> {
+    Arc::new(Mutex::new(AnisetteClient::new(SSCAnisetteProvider::new(path))))
+}
+
 pub type ArcAnisetteClient<T> = Arc<Mutex<AnisetteClient<T>>>;
 
 
