+//! Runs the emulated IMDAppleServices end-to-end against pypush's published reference hardware
+//! and reports the size of the validation data it produces.
+//!
+//! Byte length is the signal that matters: a hook that silently fails to hand over a piece of
+//! hardware identity shortens the blob (517 -> 389 when ROM and MLB go missing), and Apple
+//! rejects the short one with an opaque status 6001 at registration. Comparing against the
+//! Python reference for the SAME hardware is the fastest way to catch a divergent hook.
+//!
+//! Needs network: the flow is cert -> request -> Apple session-info -> sign. Ignored by
+//! default; run with `cargo test -p open-absinthe --release -- --ignored --nocapture`.
+
+use std::process::Command;
+
+fn b64(s: &str) -> Vec<u8> {
+    // Small dependency-free base64 decoder; this is test-only glue.
+    const T: &[u8] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    let mut out = Vec::new();
+    let mut acc = 0u32;
+    let mut bits = 0u32;
+    for c in s.bytes() {
+        if c == b'=' || c == b'\n' {
+            continue;
+        }
+        let Some(v) = T.iter().position(|t| *t == c) else { continue };
+        acc = (acc << 6) | v as u32;
+        bits += 6;
+        if bits >= 8 {
+            bits -= 8;
+            out.push((acc >> bits) as u8);
+        }
+    }
+    out
+}
+
+/// Pull one string field out of the JSON the harness wrote. Avoids a serde_json dependency.
+fn field<'a>(json: &'a str, key: &str) -> &'a str {
+    let pat = format!("\"{key}\": \"");
+    let i = json.find(&pat).unwrap_or_else(|| panic!("missing {key}")) + pat.len();
+    let rest = &json[i..];
+    &rest[..rest.find('"').expect("unterminated")]
+}
+
+fn curl(args: &[&str]) -> Vec<u8> {
+    let out = Command::new("curl").args(args).output().expect("curl");
+    assert!(out.status.success(), "curl failed: {}", String::from_utf8_lossy(&out.stderr));
+    out.stdout
+}
+
+#[test]
+#[ignore]
+fn validation_data_matches_reference_length() {
+    let dir = std::env::var("NAC_REF_DIR").expect("set NAC_REF_DIR to the harness directory");
+    let json = std::fs::read_to_string(format!("{dir}/refhw.json")).expect("refhw.json");
+
+    let hw = open_absinthe::nac::HardwareConfig {
+        product_name: field(&json, "product_name").to_string(),
+        io_mac_address: b64(field(&json, "io_mac_address")).try_into().expect("mac"),
+        platform_serial_number: field(&json, "platform_serial_number").to_string(),
+        platform_uuid: field(&json, "platform_uuid").to_string(),
+        root_disk_uuid: field(&json, "root_disk_uuid").to_string(),
+        board_id: field(&json, "board_id").to_string(),
+        os_build_num: field(&json, "os_build_num").to_string(),
+        platform_serial_number_enc: b64(field(&json, "platform_serial_number_enc")),
+        platform_uuid_enc: b64(field(&json, "platform_uuid_enc")),
+        root_disk_uuid_enc: b64(field(&json, "root_disk_uuid_enc")),
+        rom: b64(field(&json, "rom")),
+        rom_enc: b64(field(&json, "rom_enc")),
+        mlb: field(&json, "mlb").to_string(),
+        mlb_enc: b64(field(&json, "mlb_enc")),
+    };
+
+    // The public identity cert, same URL pypush uses.
+    let cert_plist = curl(&["-s", "http://static.ess.apple.com/identity/validation/cert-1.0.plist"]);
+    std::fs::write(format!("{dir}/cert.plist"), &cert_plist).unwrap();
+    let cert = plist_data(&cert_plist, "cert");
+
+    let mut request = Vec::new();
+    let mut ctx = open_absinthe::nac::ValidationCtx::new(&cert, &mut request, &hw)
+        .expect("nac_init");
+    println!("request: {} bytes", request.len());
+    assert!(!request.is_empty(), "nac_init produced an empty request");
+
+    // Apple turns the request into session info.
+    std::fs::write(format!("{dir}/request.bin"), &request).unwrap();
+    let body = std::process::Command::new("python3")
+        .args(["-c", &format!(
+            "import plistlib,sys;sys.stdout.buffer.write(plistlib.dumps({{'session-info-request':open('{dir}/request.bin','rb').read()}}))"
+        )])
+        .output().expect("python3").stdout;
+    std::fs::write(format!("{dir}/init.plist"), &body).unwrap();
+    // This endpoint answers curl and urllib with status 5003 but accepts `requests`; rather
+    // than chase the difference, use an interpreter that has it (NAC_REF_PYTHON).
+    let py = std::env::var("NAC_REF_PYTHON").unwrap_or_else(|_| "python3".into());
+    let out = Command::new(&py)
+        .args(["-c", &format!(
+            "import requests,urllib3,sys;urllib3.disable_warnings();\
+sys.stdout.buffer.write(requests.post('https://identity.ess.apple.com/WebObjects/TDIdentityService.woa/wa/initializeValidation',\
+data=open('{dir}/init.plist','rb').read(),verify=False).content)"
+        )])
+        .output().expect("python3");
+    assert!(out.status.success(), "initializeValidation failed: {}", String::from_utf8_lossy(&out.stderr));
+    let resp = out.stdout;
+
+    let session_info = plist_data(&resp, "session-info");
+    println!("session-info: {} bytes", session_info.len());
+
+    ctx.key_establishment(&session_info).expect("key_establishment");
+    let data = ctx.sign().expect("sign");
+    println!("VALIDATION DATA: {} bytes", data.len());
+    assert!(
+        data.len() > 450,
+        "validation data is only {} bytes — a hardware hook is missing (ROM/MLB drop it to 389)",
+        data.len()
+    );
+}
+
+/// Pull a <data> value out of an Apple plist response, via python3 (test-only glue).
+fn plist_data(plist: &[u8], key: &str) -> Vec<u8> {
+    let dir = std::env::var("NAC_REF_DIR").unwrap();
+    let p = format!("{dir}/tmp.plist");
+    std::fs::write(&p, plist).unwrap();
+    let out = Command::new("python3")
+        .args(["-c", &format!(
+            "import plistlib,sys;sys.stdout.buffer.write(plistlib.load(open('{p}','rb'))['{key}'])"
+        )])
+        .output()
+        .expect("python3");
+    assert!(out.status.success(), "plist read failed: {}", String::from_utf8_lossy(&out.stderr));
+    out.stdout
+}
